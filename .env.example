# ==============================================================================
# ENTERPRISE SAAS SYSTEM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/saas_db
MONGODB_DB_NAME=saas_db

# Cryptographic & Authentication Secrets
# (Must be min 32-character high-entropy string in production)
JWT_SECRET=production-grade-super-secret-key-change-this-in-production-min32bytes

# Redis Cache & Ephemeral Session Store
REDIS_URI=redis://localhost:6379

# Bun Backend Service
PORT=4000
NODE_ENV=development

# Web Dashboard URLs (CORS & Redirection)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPER_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
