{
  "expo": {
    "name": "Apex Mobile",
    "slug": "apex-saas-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "apexapp",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0b0f19"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.apex.saas.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b0f19"
      },
      "package": "com.apex.saas.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
