# ==============================================================================
# SAAS BACKEND CORE SERVICE (BUN + ELYSIA.JS)
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=development

# MongoDB Connection
# Set replica set connection string for transaction support in production
MONGODB_URI=mongodb://localhost:27017/saas_db
MONGODB_DB_NAME=saas_db

# Cryptographic & Authentication Secrets
# (Must be at least 32 characters in production)
JWT_SECRET=super-secret-development-key-change-in-production-min32chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Redis (Rate Limiting, Revocation Blacklist, Caching)
REDIS_URI=redis://localhost:6379

# Allowed CORS Origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081,exp://127.0.0.1:8081

# External Integration Webhooks (e.g., Stripe, Resend)
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RESEND_API_KEY=re_test_placeholder
