{
  "name": "saas-ecosystem",
  "private": true,
  "workspaces": [
    "super-admin",
    "backend",
    "frontend",
    "application",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\""
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.7.3",
    "prettier": "^3.5.0"
  },
  "packageManager": "bun@1.3.14"
}
